# ========================================================
# Plixamind Environment Variables Configuration
# ========================================================

# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# (If left blank, Plixamind automatically runs in local demo mode with sample data!)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Never put your Supabase service_role key here!
# Plixamind uses the public anon key combined with Supabase Row Level Security.
